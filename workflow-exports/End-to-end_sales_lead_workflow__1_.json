      "parameters": {
        "content": "##   CAPTURE\nThe second someone hits submit on the site, this webhook grabs it and we send back a quick \"thanks, we'll be in touch\" so the form never feels like it hung or failed. Everything else happens behind the scenes from here.",
        "height": 212,
        "width": 364,
        "color": 4
      },
      "id": "b849136e-ec22-49c0-9691-833d1a0a59f4",
      "name": "Sticky Note - Capture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -2816,
        464
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: \"received\", message: \"Thanks! We'll be in touch shortly.\" } }}",
        "options": {}
      },
      "id": "ffd65bfc-37f2-45a9-9d25-ab1c396beae5",
      "name": "2. Instant 200 Response",
      "type": "n8n-nodes-base.respondToWebhook",
