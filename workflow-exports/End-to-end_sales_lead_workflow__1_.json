    {
      "parameters": {
        "jsCode": "// Normalize incoming payload into a consistent shape and validate for QUALITY,\n// not just presence. Presence-only checks let obvious junk/test submissions\n// (placeholder company names, gibberish messages) flow all the way through\n// the pipeline as \"valid\".\nconst body = $input.first().json.body || $input.first().json;\n\nconst normalized = {\n  name: (body.name || body.full_name || '').toString().trim(),\n  email: (body.email || '').toString().trim().toLowerCase(),\n  company: (body.company || body.company_name || '').toString().trim(),\n  company_size: Number(body.company_size || body.team_size || 0) || 0,\n  timeline: (body.timeline || '').toString().trim().toLowerCase(),\n  message: (body.message || body.notes || '').toString().trim(),\n  source: body.source || 'website_form',\n  received_at: new Date().toISOString()\n};\n\nconst reasons = [];\n\n// 1. Email: must exist AND actually look like an email.\nconst emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!normalized.email) {\n  reasons.push('email missing');\n} else if (!emailPattern.test(normalized.email)) {\n  reasons.push('email format invalid');\n}\n\n// 2. Company: reject empty, too-short, or common placeholder values.\nconst junkCompanyWords = new Set(['you', 'me', 'test', 'testing', 'n/a', 'na', 'none', 'asdf', 'x', 'xx', 'xxx', 'company', '-', '.']);\nif (!normalized.company || normalized.company.length < 2) {\n  reasons.push('company missing or too short');\n} else if (junkCompanyWords.has(normalized.company.toLowerCase())) {\n  reasons.push('company looks like placeholder/test data');\n}\n\n// 3. Message: reject empty, too-short, or gibberish (repeated chars, filler words).\nconst repeatedCharPattern = /(.)\\1{2,}/; // e.g. \"blahhh\", \"yesss\", \"aaaa\"\nconst junkMessageWords = new Set(['blah', 'blahhh', 'asdf', 'asdfasdf', 'test', 'testing', 'lorem', 'lorem ipsum', 'n/a', '...']);\nconst msgClean = normalized.message.toLowerCase().trim();\nif (!normalized.message || normalized.message.length < 3) {\n  reasons.push('message missing or too short');\n} else if (junkMessageWords.has(msgClean) || repeatedCharPattern.test(msgClean)) {\n  reasons.push('message looks like test/spam text');\n}\n\n// 4. Name: reject empty, too-short, or placeholder values.\nconst junkNames = new Set(['test', 'testing', 'asdf', 'n/a', 'na', 'none', 'spam', 'x', 'xx']);\nif (!normalized.name || normalized.name.length < 2) {\n  reasons.push('name missing or too short');\n} else if (junkNames.has(normalized.name.toLowerCase())) {\n  reasons.push('name looks like placeholder/test data');\n}\n\nnormalized.is_valid = reasons.length === 0;\nnormalized.missing_fields = reasons;\n\nreturn [{ json: normalized }];"
      },
      "id": "5fc11790-2f1a-4668-9620-b9ab0eb040e9",
      "name": "3. Normalize & Validate Lead",
