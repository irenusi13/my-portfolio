    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following B2B SaaS lead.\n\nName:\n{{ $json.name }}\n\nEmail:\n{{ $json.email }}\n\nCompany:\n{{ $json.company }}\n\nCompany Size:\n{{ $json.company_size }}\n\nTimeline:\n{{ $json.timeline }}\n\nLead Source:\n{{ $json.source }}\n\nMessage:\n{{ $json.message }}\n\nDetermine:\n\n- Priority\n- Urgency\n- Summary\n\n\nReturn JSON only.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are Athena, an AI Sales Qualification Assistant for a B2B SaaS company called Loomwork Automation.\n\nYour job is to analyze an incoming lead submission and determine how valuable the lead is.  Evaluate the lead using the following signals:  \n• Company size \n• Urgency or timeline \n• Clarity of the request \n\n Return ONLY valid JSON.  \n\nUse this schema: \n {     \n\"priority\": \"<Hot|Standard>\",  \n\"urgency\": \"<High|Medium|Low>\",   \n\"summary\": \"<One sentence summarizing the lead's request>\" }  \n\n\nRules:  \n- Do not invent facts. \n- Base conclusions only on the information provided. \n- Keep the summary under 20 words. \n- Return JSON only."
            }
          ]
        },
        "batching": {}
      },
